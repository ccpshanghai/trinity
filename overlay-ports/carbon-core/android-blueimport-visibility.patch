diff --git a/include/CcpMacros.h b/include/CcpMacros.h
index e6229df..9d2298e 100644
--- a/include/CcpMacros.h
+++ b/include/CcpMacros.h
@@ -15,12 +15,16 @@
 			#define BLUEIMPORT __declspec(dllimport)
 		#endif
 	#endif
-#elif defined(__APPLE__)
+#elif defined(__GNUC__) || defined(__clang__)
+// Every ELF/Mach-O toolchain here (Apple clang, NDK clang, gcc) builds blue with
+// -fvisibility=hidden, so the API has to opt in. This branch used to be __APPLE__
+// only, which left Android's blue.so exporting nothing of its own: the engine's
+// first C++ link against it (M6, _trinity_vulkan.so) failed on every Be* global.
 #ifdef BLUEBUILD_STATIC
 #define BLUEIMPORT
 #else
 #ifdef BLUEBUILD
-#define BLUEIMPORT __attribute((visibility("default")))
+#define BLUEIMPORT __attribute__((visibility("default")))
 #else
 #define BLUEIMPORT
 #endif
